# Token do bot no Discord Developer Portal
DISCORD_TOKEN="SEU_TOKEN_DO_DISCORD_AQUI"

# Chave gratuita da API do Gemini (Google AI Studio)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Canal onde o bot criará as threads
CANAL_SUPORTE="suporte"

# Modelo Gemini (padrão: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"
PORT=8080